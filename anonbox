cmd_all()
{
    require_root
    validate_os
    step "Starting anonbox Complete Automated Deployment Pipeline"
    detect_network
    show_system_summary

    IN_PIPELINE=1

    phase_header "1" "3" "Network, Tor Transparent Proxy & Fail-Closed Firewall"
    cmd_setup

    phase_header "2" "3" "System, Kernel, Memory & Session Hardening"
    cmd_harden

    phase_header "3" "3" "Security Audit, Leak Detection & Verification"
    cmd_check
}

# =============================================================================
# SUBCOMMAND: status
# =============================================================================

cmd_status()
{
    step "anonbox Operational Status"
    detect_network
    local is_active
    is_active="$(systemctl is-active tor@default 2>/dev/null || echo 'inactive')"
    local nft_active
    nft_active="$(systemctl is-active nftables 2>/dev/null || echo 'inactive')"

    info "Tor Service Status    : $is_active"
    info "nftables Firewall     : $nft_active"
    info "Primary Network NIC   : $IFACE ($LAN_SUBNET)"

    local current_mac
    current_mac="$(cat "/sys/class/net/${IFACE}/address" 2>/dev/null || ip link show dev "$IFACE" 2>/dev/null | awk '/ether/ {print $2; exit}' || echo 'unknown')"
    info "Active Hardware MAC   : $current_mac"

    if [[ "$is_active" == "active" ]]; then
        local tor_pid
        tor_pid="$(systemctl show --property MainPID --value tor@default 2>/dev/null || echo '')"
        [[ -n "$tor_pid" && "$tor_pid" != "0" ]] && info "Tor Main PID          : $tor_pid"

        local current_ip
        current_ip="$(curl -s --socks5-hostname 127.0.0.1:9050 --max-time 10 https://check.torproject.org/api/ip 2>/dev/null | grep -o '"IP":"[^"]*' | cut -d'"' -f4 || echo 'Unavailable')"
        info "Active Tor Exit IP    : $current_ip"
        info "System Timezone       : $(timedatectl show --property=Timezone --value 2>/dev/null || echo 'unknown')"

        # Stream Isolation Ports Status
        local port_9050="Inactive" port_9051="Inactive" port_9052="Inactive" port_5353="Inactive"
        if nc -z 127.0.0.1 9050 2>/dev/null; then port_9050="Listening (General / Browsing)"; fi
        if nc -z 127.0.0.1 9051 2>/dev/null; then port_9051="Listening (Financial / Wallets)"; fi
        if nc -z 127.0.0.1 9052 2>/dev/null; then port_9052="Listening (CLI / Automation)"; fi
        if nc -z 127.0.0.1 5353 2>/dev/null || nc -u -z -w 1 127.0.0.1 5353 2>/dev/null; then port_5353="Listening (Tor DNSPort)"; fi

        info "SOCKS5 Stream Ports   : 9050 ($port_9050)"
        info "                      : 9051 ($port_9051)"
        info "                      : 9052 ($port_9052)"
        info "DNS Interception Port : 127.0.0.1:5353 ($port_5353)"

        local boot_log
        boot_log="$(journalctl -u tor@default.service -n 20 --no-pager 2>/dev/null | grep "Bootstrapped 100%" | tail -n 1 || echo '')"
        if [[ -n "$boot_log" ]]; then
            info "Bootstrap State       : 100% (Operational)"
        else
            info "Bootstrap State       : Active (Review journalctl for progress)"
        fi
    fi

    # Storage Encryption Status
    local enc_status="Unencrypted (No eCryptfs or LUKS detected)"
    local ecryptfs_mounts=""
    if [[ -f "/proc/mounts" ]]; then
        ecryptfs_mounts="$(awk '$3 == "ecryptfs" { print $2 }' /proc/mounts 2>/dev/null | tr '\n' ' ' || echo '')"
    fi
    if [[ -n "$ecryptfs_mounts" ]]; then
        enc_status="Active (eCryptfs on ${ecryptfs_mounts% })"
    elif command -v lsblk >/dev/null 2>&1 && lsblk -f 2>/dev/null | grep -qE "crypto_LUKS|crypt"; then
        enc_status="Active (LUKS / dm-crypt block encryption)"
    elif command -v dmsetup >/dev/null 2>&1 && dmsetup status --target crypt 2>/dev/null | grep -q ":"; then
        enc_status="Active (dm-crypt)"
    fi
    info "Storage Encryption    : $enc_status"
    warn_iface_ip_drift
}

# =============================================================================
# SUBCOMMAND: rollback
# =============================================================================

cmd_rollback()
{
    require_root
    step "Available Backups in $BACKUP_DIR"
    if [[ ! -d "$BACKUP_DIR" ]]; then
        die "No backups directory found at $BACKUP_DIR"
    fi

    local backups=()
    mapfile -t backups < <(find "$BACKUP_DIR" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort || true)
    if [[ ${#backups[@]} -eq 0 ]]; then
        die "No backup snapshots found in $BACKUP_DIR"
    fi

    info "Found ${#backups[@]} backup snapshots:"
    local i=1
    local b
    for b in "${backups[@]}"; do
        printf '  [%d] %s\n' "$i" "$(basename "$b")"
        ((i++)) || true
    done

    local selected=""
    if [[ -n "$ROLLBACK_SNAPSHOT" ]]; then
        selected="${BACKUP_DIR}/${ROLLBACK_SNAPSHOT}"
        if [[ ! -d "$selected" ]]; then
            die "Snapshot not found: $ROLLBACK_SNAPSHOT (expected directory $selected)"
        fi
    elif [[ -t 0 ]]; then
        local sel
        printf 'Select snapshot number [1-%d]: ' "${#backups[@]}"
        read -r sel
        if [[ ! "$sel" =~ ^[0-9]+$ ]] || (( sel < 1 || sel > ${#backups[@]} )); then
            die "Invalid snapshot selection"
        fi
        selected="${backups[$((sel - 1))]}"
    else
        die "Non-interactive rollback requires --snapshot ID (directory name under $BACKUP_DIR)"
    fi

    local clean_latest="${selected%/}"
    info "Restoring snapshot: $(basename "$clean_latest")"
    restore_snapshot_files "$clean_latest"

    if [[ -f "$NFTABLES_CONF" ]]; then
        nft -f "$NFTABLES_CONF" 2>/dev/null || true
        systemctl restart nftables 2>/dev/null || true
    fi
    sysctl --system 2>/dev/null || true
    local aa_profile
    aa_profile="$(find_tor_apparmor_profile)"
    if [[ -n "$aa_profile" ]] && command -v apparmor_parser >/dev/null 2>&1; then
        apparmor_parser -r "$aa_profile" 2>/dev/null || true
    fi
    systemctl restart tor@default 2>/dev/null || true
    ok "Rollback applied and services restarted."
}

# =============================================================================
# SUBCOMMAND: uninstall
# =============================================================================

cmd_uninstall()
{
    require_root
    step "Uninstalling anonbox Configuration (Restoring standard networking)"
    detect_network

    local backups=()
    if [[ -d "$BACKUP_DIR" ]]; then
        mapfile -t backups < <(find "$BACKUP_DIR" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort || true)
    fi
    if [[ ${#backups[@]} -gt 0 ]]; then
        local snap="${backups[0]}"
        info "Restoring original files from first snapshot $(basename "$snap")"
        restore_snapshot_files "$snap"
    else
        warn "No snapshots in $BACKUP_DIR; removing anonbox units and flushing firewall only"
    fi

    if command -v nft >/dev/null 2>&1; then
        run nft flush ruleset 2>/dev/null || true
        run systemctl disable --now nftables 2>/dev/null || true
        ok "nftables firewall rules flushed and disabled"
    fi

    run systemctl disable --now tor@default 2>/dev/null || true
    ok "Tor service stopped (will not restart with TransPort and no kill-switch)"

    run systemctl disable --now htpdate-tor.service 2>/dev/null || true
    run rm -f "$HTPDATE_SERVICE"

    run systemctl disable --now "macchanger@${IFACE}.service" 2>/dev/null || true
    run rm -f "$MAC_SERVICE"

    local noisy_services=(avahi-daemon cups cups-browsed bluetooth ModemManager systemd-timesyncd geoclue kerneloops whoopsie)
    local svc
    for svc in "${noisy_services[@]}"; do
        run systemctl unmask "${svc}.service" 2>/dev/null || true
    done
    run systemctl enable --now systemd-timesyncd.service 2>/dev/null || true
    ok "System services unmasked and systemd-timesyncd enabled"

    run rm -f "$NM_DNS_CONF"
    run rm -f "$NM_MAC_CONF"
    run rm -f "$NM_CONN_CONF"
    run rm -f "$NFTABLES_OVERRIDE"
    run rm -f "$LOCALNET_SYSCTL"
    run rm -f "$SYSCTL_FILE"
    run rm -f "$PROFILE_HISTORY"
    run rm -f "$SUDOERS_HARDENING"
    run rm -f "$LIMITS_COREDUMP"
    run rm -f "$MODPROBE_BLACKLIST"
    run rm -f "$ANONBOX_TOR_DEFAULTS"
    run rm -f "$TOR_UNIT_DROPIN"
    run rmdir /etc/systemd/system/tor@default.service.d 2>/dev/null || true
    run systemctl unmask systemd-resolved 2>/dev/null || true
    run systemctl daemon-reload
    run systemctl restart NetworkManager 2>/dev/null || true
    run systemctl enable --now systemd-resolved 2>/dev/null || true
    run sysctl --system 2>/dev/null || true

    local aa_profile
    aa_profile="$(find_tor_apparmor_profile)"
    if [[ -n "$aa_profile" ]] && command -v apparmor_parser >/dev/null 2>&1; then
        apparmor_parser -r "$aa_profile" 2>/dev/null || true
    fi

    ok "anonbox uninstalled. Standard clearnet networking restored from first snapshot (if present)."
}

# =============================================================================
# Help and Usage
# =============================================================================

show_help()
{
    cat << EOF
anonbox Toolkit v${VERSION} — Self-Hosted Hardened Tor Workstation for Debian VMs

Usage:
  sudo ./anonbox <command> [options]

Commands:
  setup       Install packages, configure torrc, bridges, nftables, and fail-closed routing
  harden      Apply comprehensive OS, kernel (Yama, sysctl, GRUB), user, and filesystem hardening
  check       Run the leak-detection and hardening audit (kill-switch, LUKS, AppArmor)
  all         Execute full pipeline: setup -> harden -> check
  status      Show current Tor connection health, circuits, and public exit IP
  rollback    Restore a snapshot from /var/backups/anonbox/ (--snapshot ID or interactive)
  uninstall   Restore the first/oldest snapshot, flush firewall, and restore clearnet
  version     Display version information
  help        Show this help message

Options:
  --bridges-file FILE   Specify path to file containing obfs4 bridge lines
  --no-bridges          Configure Tor without bridges (direct connection)
  --iface IFACE         Force specific network interface (e.g. enp0s1, eth0)
  --snapshot ID         Snapshot directory name under /var/backups/anonbox/ (rollback)
  --allow-ssh           Allow inbound SSH from RFC1918 (required for remote setup/testing)
  --verbose, -v         Enable detailed output and command tracing
  --dry-run             Preview actions without making system changes

Examples:
  sudo ./anonbox all --allow-ssh
  sudo ./anonbox setup --bridges-file bridges.txt
  sudo ./anonbox harden --verbose
  sudo ./anonbox check
  sudo ./anonbox all --bridges-file bridges.txt
EOF
}

# =============================================================================
# Main Entrypoint
# =============================================================================

main()
{
    [[ $# -eq 0 ]] && { show_help; exit 0; }

    local command="$1"
    shift

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --bridges-file)
                [[ $# -lt 2 ]] && die "--bridges-file requires a FILE argument"
                BRIDGES_FILE="$2"
                shift 2
                ;;
            --no-bridges)
                NO_BRIDGES=1
                shift
                ;;
            --iface)
                [[ $# -lt 2 ]] && die "--iface requires an INTERFACE argument"
                FORCE_IFACE="$2"
                shift 2
                ;;
            --snapshot)
                [[ $# -lt 2 ]] && die "--snapshot requires a snapshot ID argument"
                ROLLBACK_SNAPSHOT="$2"
                shift 2
                ;;
            --allow-ssh)
                ALLOW_SSH=1
                shift
                ;;
            --verbose|-v)
                VERBOSE=1
                shift
                ;;
            --dry-run)
                DRY_RUN=1
                shift
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            *)
                die "Unknown option: $1 (see: ./anonbox help)"
                ;;
        esac
    done

    case "$command" in
        setup)      cmd_setup ;;
        harden)     cmd_harden ;;
        check)      cmd_check ;;
        all)        cmd_all ;;
        status)     cmd_status ;;
        rollback)   cmd_rollback ;;
        uninstall)  cmd_uninstall ;;
        version)    printf 'anonbox v%s\n' "$VERSION" ;;
        help|-h)    show_help ;;
        *)          die "Unknown command: $command (run './anonbox help' for available commands)" ;;
    esac
}

main "$@"
