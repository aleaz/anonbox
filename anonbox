set -euo pipefail

VERSION="1.2.0"

# =============================================================================
# Global Configurations & File Paths
# =============================================================================

# --- net: nftables / sysctl / interface discovery ---
# --- tor: torrc / AppArmor / bootstrap ---
# (Monolith kept intentional; section tags aid review without a lib/ split.)

TORRC="/etc/tor/torrc"
TOR_DEFAULTS="/usr/share/tor/tor-service-defaults-torrc"
ANONBOX_TOR_DEFAULTS="/etc/tor/anonbox-defaults-torrc"
TOR_UNIT_DROPIN="/etc/systemd/system/tor@default.service.d/anonbox.conf"
NFTABLES_CONF="/etc/nftables.conf"
NFTABLES_OVERRIDE="/etc/systemd/system/nftables.service.d/override.conf"
SYSCTL_FILE="/etc/sysctl.d/99-tor-hardening.conf"
MAC_SERVICE="/etc/systemd/system/macchanger@.service"
NM_MAC_CONF="/etc/NetworkManager/conf.d/00-mac-randomize.conf"
NM_CONN_CONF="/etc/NetworkManager/conf.d/20-connectivity.conf"
NM_DNS_CONF="/etc/NetworkManager/conf.d/no-dns.conf"
HTPDATE_SERVICE="/etc/systemd/system/htpdate-tor.service"
